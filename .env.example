# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# The real domain, without a trailing slash (e.g. https://alanadi.com).
# While empty, the site uses the Vercel URL and stays out of search results.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (Resend). The form reports "not active" until all three are set.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
